{
  "expo": {
    "name": "Sport",
    "slug": "sport",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "com.nmichel.sport",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0c0e",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Povoliť kameru na načítanie QR vstupenky do turnaja."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "barStyle": "light",
          "visibility": "visible"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa2b5012-5e33-49e4-a521-f1f10a1f2502"
      }
    },
    "android": {
      "package": "com.nmichel.sport",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#0b0c0e",
      "edgeToEdgeEnabled": true
    },
    "androidStatusBar": {
      "hidden": false,
      "translucent": true,
      "barStyle": "light-content"
    }
  }
}
